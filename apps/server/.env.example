PORT=3000
# 로컬 PostgreSQL 16. role 은 OS 사용자와 같은 이름으로 만든다 (README 참고). host= 는 유닉스 소켓 경로 — peer 인증이라 비밀번호가 없다
DATABASE_URL=postgresql://taehwan@localhost:5432/oneureodi?schema=public&host=/var/run/postgresql

# https://developers.kakao.com  > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# https://app.tavily.com — 구글 계정으로 가입, 카드 없이 월 1,000회. 비우면 LLM 의 웹검색 그라운딩을 쓴다 (Gemini 무료 등급에서는 대개 429)
TAVILY_API_KEY=

# AI 제공자: gemini (카드 없이 무료 등급, 기본) | openai (크레딧 충전 필요)
LLM_PROVIDER=gemini

# https://aistudio.google.com/apikey — 구글 계정으로 로그인해 "Create API key". 결제 정보를 안 넣으면 Free 등급
GEMINI_API_KEY=
# 웹검색(Google 검색 그라운딩)으로 코스 추천 글 찾기 + 장소 뽑기. 무료 등급에서 검색 월 5,000회 (3.x 모델 공유)
GEMINI_SEARCH_MODEL=gemini-3.6-flash
# 후보 중 코스 짜기
GEMINI_COMPOSE_MODEL=gemini-3.6-flash
# 주 모델이 과부하(503)·쿼터(429)면 이 모델로 한 번 더 시도. 무료 등급에서 자주 필요하다
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# LLM_PROVIDER=openai 일 때만 필요. https://platform.openai.com
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-5.6-luna
OPENAI_COMPOSE_MODEL=gpt-5.6-terra

# 차 있음 / 없음일 때 검색 반경 (미터). "대중교통 10~20분" 을 직선거리로 근사한 값
CAR_RADIUS_M=5000
NO_CAR_RADIUS_M=3000
# 모아둔 장소·블로그 정보를 다시 쓰는 기간(일)
CACHE_TTL_DAYS=7
# 외부 API 호출 하나당 제한 시간
EXTERNAL_TIMEOUT_MS=4000
# LLM 호출 하나당 제한 시간
LLM_TIMEOUT_MS=15000
# 웹 검색 도구를 쓰는 LLM 호출의 제한 시간 (검색이 여러 번 돌아 오래 걸린다)
LLM_TOOL_TIMEOUT_MS=40000
# 코스 구성 LLM 에 넘기는 후보 장소 수 상한
MAX_LLM_CANDIDATES=60
# 웹 글에 나왔지만 지도 검색 결과에 없는 장소를 카카오에서 추가 조회하는 상한
MAX_MENTION_LOOKUPS=20
