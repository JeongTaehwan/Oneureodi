    "@oneureodi/shared": "*",
    "@prisma/client": "^6.19.3",
    "openai": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "jest": "^30.5.1",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
